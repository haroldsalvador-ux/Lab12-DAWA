  "item": [
    {
      "name": "1. GET Todos los autores",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/authors",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "authors"
          ],
          "protocol": "http",
          "port": "3000"
        }
      }
    },
    {
      "name": "2. POST Crear autor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/authors",
          "host": [
            "localhost"
          ],
          "path": [
            "api",
            "authors"
          ],
          "protocol": "http",
          "port": "3000"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gabriel García Márquez\",\n  \"email\": \"gabo@example.com\",\n  \"nationality\": \"Colombia\",\n  \"birthYear\": 1927,\n  \"bio\": \"Premio Nobel de Literatura 1982\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (res.id) pm.collectionVariables.set('authorId', res.id);"
            ]
          }
        }
      ]
    },
